; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="random-rpg"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Global="*uid://dm6ia0flo8t1t"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={
"intro": "res://assets/dialogic/intro.dtl",
"test-timeline": "res://assets/dialogic/test-timeline.dtl"
}
layout/style_directory={}
layout/style_list=["res://assets/dialogic/visualnovelstyle.tres"]
layout/default_style="res://assets/dialogic/visualnovelstyle.tres"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg")

[global_group]

RpgEnemy=""
RpgPlayer=""

